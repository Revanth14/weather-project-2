# Local development only. In Databricks, the app reads the existing secret.
LAKEBASE_URL=postgresql://role:password@host:5432/databricks_postgres?sslmode=require

# Used when LAKEBASE_URL is absent.
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

# Identify your NWS client with real contact information before deployment.
NWS_USER_AGENT=weather-intelligence-homework/1.0 (your-email@example.com)
WEATHER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FLASK_RUN_PORT=8000

